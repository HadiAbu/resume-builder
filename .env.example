# Postgres connection string used when running the backend directly (not via
# docker compose) - e.g. `uvicorn` from backend/. Matches docker-compose.yml's
# defaults below.
DATABASE_URL=postgresql+psycopg2://resume_builder:resume_builder@localhost:5432/resume_builder

# Signs and verifies session JWTs (backend/app/security.py). Required - the
# backend fails fast at startup without it. docker-compose.yml has a
# dev-only default baked in; for a real deployment generate a random 32+
# byte value, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SESSION_SECRET=local-dev-only-secret-not-for-production-use

# Override docker-compose's Postgres credentials (optional - these are the
# defaults already baked into docker-compose.yml). Copy this file to .env at
# the repo root to change them; docker compose reads .env automatically.
# POSTGRES_DB=resume_builder
# POSTGRES_USER=resume_builder
# POSTGRES_PASSWORD=resume_builder

# Raises the GitHub API rate limit from 60/hr (unauthenticated) to 5000/hr
# for project import (backend/app/github.py). Optional - a plain personal
# access token (https://github.com/settings/tokens) with no special scopes
# needed for public data. Leave unset for occasional imports.
# GITHUB_TOKEN=

# Not used yet - arrives with feature 6 (AI keyword generation). Don't add
# code paths for this until that feature needs it.
# ANTHROPIC_API_KEY=
