# Postgres connection string used when running the backend directly (not via
# docker compose) - e.g. `uvicorn` from backend/. Matches docker-compose.yml's
# defaults below.
DATABASE_URL=postgresql+psycopg2://resume_builder:resume_builder@localhost:5432/resume_builder

# Override docker-compose's Postgres credentials (optional - these are the
# defaults already baked into docker-compose.yml). Copy this file to .env at
# the repo root to change them; docker compose reads .env automatically.
# POSTGRES_DB=resume_builder
# POSTGRES_USER=resume_builder
# POSTGRES_PASSWORD=resume_builder

# Not used yet - arrive with feature 6 (AI keyword generation) and
# feature 3 (owner authentication) respectively. Don't add code paths for
# these until those features need them.
# ANTHROPIC_API_KEY=
# SESSION_SECRET=
